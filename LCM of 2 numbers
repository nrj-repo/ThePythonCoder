# lcm of 2 given numbers

def calculate_lcm(num1,num2):
    if num1 > num2:
        greater = num1
    else:
        greater = num2
    while True:
        if (greater % num1 == 0) and (greater % num2 == 0):
            lcm = greater
            break
        greater += 1
    return lcm


number1 = int(input("Enter the number1: "))
number2 = int(input("Enter the number2: "))
print(f"The lcm of {number1} and {number2} is : ",calculate_lcm(number1,number2))
