import random
import turtle as t


t.colormode(255)
t.speed("fastest")
def random_colors():
    r = random.randint(0,255)
    g = random.randint(0, 255)
    b = random.randint(0, 255)
    random_color = (r,g,b)
    return random_color

def draw_spirograph(size_of_gap):
    for _ in range(int(360/size_of_gap)):
        t.color(random_colors())
        t.circle(100)
        t.setheading(t.heading() + size_of_gap)

draw_spirograph(5)

screen = t.Screen()
screen.exitonclick()
